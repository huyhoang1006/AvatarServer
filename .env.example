# ====== Server ======
NODE_ENV=development
PORT=3000

# ====== Public Base URL (used in OAuth verification URLs) ======
# Must match the redirect URI registered in Google/FB consoles.
PUBLIC_BASE_URL=http://localhost:3000

# ====== Database (PostgreSQL) ======
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=avatar
DB_PASSWORD=avatar_pass
DB_NAME=avatar_farm
DB_SYNCHRONIZE=true
# Set false in production and use migrations
# DB_SYNCHRONIZE=false

# ====== Redis ======
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ====== JWT ======
JWT_SECRET=change-me-in-production-please-use-32-bytes-random
JWT_EXPIRES_IN=7d

# ====== Session ======
SESSION_TTL_SECONDS=1800
GRACE_PERIOD_SECONDS=300
AUTO_SAVE_INTERVAL_SECONDS=30

# ====== WebSocket ======
WS_PATH=/ws

# ============================================================
# OAuth (Google + Facebook)
# ============================================================
# To enable Google login:
#   1. Create a project at https://console.cloud.google.com/
#   2. APIs & Services → Credentials → Create OAuth Client ID (Web application)
#   3. Authorized redirect URIs: https://yourdomain.com/auth/google/callback
#   4. Copy Client ID + Secret below and restart server
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://yourdomain.com/auth/google/callback

# To enable Facebook login:
#   1. Create an app at https://developers.facebook.com/
#   2. Settings → Basic → copy App ID + App Secret
#   3. Settings → Valid OAuth Redirect URIs: https://yourdomain.com/auth/facebook/callback
#   4. Make the app Live (or add testers in Roles)
#
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_CALLBACK_URL=https://yourdomain.com/auth/facebook/callback
